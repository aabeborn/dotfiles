{
  "use_system_window_tabs": true,
  "git_panel": {
    "scrollbar": {
      "show": "never",
    },
  },
  "terminal": {
    "dock": "bottom",
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enabled": true,
    "enable_preview_from_file_finder": true,
  },
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": false,
    "close_position": "right",
    "git_status": false,
  },
  "tab_bar": {
    "show": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_icon": false,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "project_panel": {
    "hide_hidden": true,
    "hide_root": false,
    "scrollbar": {
      "show": "never",
    },
    "hide_gitignore": true,
    "default_width": 250.0,
    "dock": "right",
    "button": true,
  },
  "use_smartcase_search": true,
  "search": {
    "regex": true,
  },
  "prettier": {
    "allowed": true,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "enabled": false,
    "line_width": 0,
  },
  "show_wrap_guides": true,
  "toolbar": {
    "code_actions": true,
  },
  "autoscroll_on_clicks": true,
  "agent_buffer_font_size": 12.0,
  "ui_font_size": 13.0,
  "ui_font_family": "GeistMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "restore_on_startup": "none",
  "vim_mode": true,
  "buffer_font_size": 11.0,
  "buffer_font_family": "GeistMono Nerd Font",
  "agent_ui_font_size": 13.0,
  "sticky_scroll": {
    "enabled": true,
  },
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine Moon",
  },
  "features": {
    "edit_prediction_provider": "supermaven",
  },
  "formatter": "prettier",
}
