# Copy to ~/.config/zsh/env.local (gitignored). Secrets and machine-specific values only.
# Loaded by zshrc. Never commit real values.

# Qonto signing key (public key, read by git via gpg.ssh.defaultKeyCommand)
export QONTO_SSH_KEY=""

# AI providers
export EDGEE_API_KEY=""
export OPENAI_API_KEY=""

# Localisation
export LOKALISE_API_KEY=""

# OpenCode telemetry (Qonto machine, managed by Jamf)
export OPENCODE_ENABLE_TELEMETRY=1
export OPENCODE_OTLP_ENDPOINT=""
export OPENCODE_OTLP_PROTOCOL=http/protobuf
export OPENCODE_RESOURCE_ATTRIBUTES=""
