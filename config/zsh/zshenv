# 🧭 ~/.zshenv — read by every zsh, interactive or not, login or not.
# Keep it small: Homebrew environment and Homebrew behaviour only.

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export HOMEBREW_NO_ANALYTICS=1   # no usage reporting to Homebrew
export HOMEBREW_NO_ENV_HINTS=1   # quieter output
