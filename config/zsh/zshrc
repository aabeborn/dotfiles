# 🐚 Zsh base – calm and layered 😌

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Completion
autoload -Uz compinit
compinit -d "$HOME/.zcompdump"

# Editor
export EDITOR=vim
export VISUAL=vim
export TERM=xterm-256color

# PATH (minimal)
typeset -U path
path=("$HOME/.local/bin" "/opt/homebrew/bin" $path)


# Load layers (if present)
ZSH_CONFIG_DIR="$HOME/.config/zsh"
for file in \
    "$ZSH_CONFIG_DIR/pure.zsh" \
    "$ZSH_CONFIG_DIR/tools.zsh" \
    "$ZSH_CONFIG_DIR/aliases.zsh" \
    "$ZSH_CONFIG_DIR/plugins.zsh" \
    "$HOME/.zshrc.local"
  # "$HOME/.config/zsh/tools.zsh" \
  # "$HOME/.config/zsh/aliases.zsh" \
  # "$HOME/.config/zsh/plugins.zsh" \
do
  [ -f "$file" ] && source "$file"
done


# ✨ Prompt (Pure via Homebrew)
autoload -Uz promptinit
promptinit
prompt pure
