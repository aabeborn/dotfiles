# 🧰 Git behaviour. No identity, no secrets.
# Identity and per-folder profiles live outside the repo, in ~/.config/git-local/identity.gitconfig.

[include]
	path = ~/.config/git-local/identity.gitconfig

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[commit]
	verbose = true

[core]
	pager = delta

[delta]
	navigate = true
