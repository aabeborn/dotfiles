# 🧰 Git behaviour. No identity, no secrets.
# Default identity is Qonto. Personal repos override it below.
# Identity and signing live in ~/.config/git-local/ (not versioned).

[include]
	path = ~/.config/git-local/qonto.gitconfig

[includeIf "gitdir:~/aabeborn/"]
	path = ~/.config/git-local/personal.gitconfig

[includeIf "hasconfig:remote.*.url:https://github.com/aabeborn/**"]
	path = ~/.config/git-local/personal.gitconfig

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[commit]
	verbose = true

[core]
	pager = delta

[delta]
	navigate = true
