# 🧰 Git base configuration
# Behavior only. No identity. No secrets. 😌

[color]
	ui = auto

[pull]
	rebase = true

[push]
	default = simple

[fetch]
	prune = true

[rebase]
	autoStash = true

[init]
	defaultBranch = main

[commit]
	verbose = true

[core]
  pager = delta

[delta]
  navigate = true
  side-by-side = false

# 🧘 Calm defaults
# Identity, SSH, signing, and credentials are handled elsewhere
